#!/bin/sh
set -e
S=/var/lib/libre-computer-archive-keyring
# the rename under way: libre-computer-migrate holds the "renaming" mark while it runs, and apt may remove or purge
# the old libretech-keyring before it unpacks libre-computer-archive-keyring, which takes the unit and the state
# over. Then the timer's link and the state stay. Any other removal (libre-computer-archive-keyring itself, or the
# owner removing libretech-keyring by hand) takes them with it: nothing would run the work left
# The mark names the boot, the migration's pid and that process's start time: one a power loss or a kill left
# behind (that process gone, or its pid now another's) is no rename under way. And this removal must be the
# migration's own: the process running this script descends from it (the migration sets the mark just before
# its apt or dpkg run, which another apt, running already, could still beat to the lock -- that removal is the
# owner's)
renaming() {
	[ "${DPKG_MAINTSCRIPT_PACKAGE:-}" != libre-computer-archive-keyring ] && [ -s "$S/renaming" ] || return 1
	read -r rb rp rs < "$S/renaming" || return 1
	[ -n "${rp:-}" ] && kill -0 "$rp" 2>/dev/null || return 1
	bid=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)
	bst=$(sed 's/.*) //' "/proc/$rp/stat" 2>/dev/null | cut -d' ' -f20 || true)
	[ "$rb" = "${bid:--}" ] && [ "${rs:-}" = "${bst:--}" ] || return 1
	# up this process's parents (the field after the state, past the ") " ending the command name), at most 64
	x=$$ i=0
	while [ "$x" -gt 1 ] 2>/dev/null && [ $i -lt 64 ]; do
		[ "$x" != "$rp" ] || return 0
		x=$(sed 's/.*) //' "/proc/$x/stat" 2>/dev/null | cut -d' ' -f2) || return 1
		i=$((i + 1))
	done
	return 1
}
case "$1" in
	purge)
		# the state, unless the rename is under way or the other name, installed, still uses it
		if ! renaming && { [ "${DPKG_MAINTSCRIPT_PACKAGE:-}" = libre-computer-archive-keyring ] ||
			[ ! -e /usr/lib/libre-computer-archive-keyring/libre-computer-migrate ]; }; then
			rm -rf "$S"
		fi
		;;
	remove)
		# the timer's link, unless the rename is under way or another package still ships the unit
		if ! renaming && { [ "${DPKG_MAINTSCRIPT_PACKAGE:-}" = libre-computer-archive-keyring ] ||
			[ ! -e /usr/lib/systemd/system/libre-computer-migrate.timer ]; }; then
			rm -f /etc/systemd/system/timers.target.wants/libre-computer-migrate.timer
			# and the loaded timer stopped, so it does not keep starting a script that is gone
			# (only this root's own running systemd: not from an image build, even with the build host's
			# /run bound in)
			if [ -d /run/systemd/system ] && [ -e /proc/1/comm ] && ! systemd-detect-virt --chroot --quiet 2>/dev/null; then
				systemctl stop --no-block libre-computer-migrate.timer >/dev/null 2>&1 || true
				systemctl daemon-reload >/dev/null 2>&1 || true
			fi
		fi
		;;
esac
#DEBHELPER#
exit 0
