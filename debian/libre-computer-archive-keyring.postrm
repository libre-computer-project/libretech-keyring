#!/bin/sh
set -e
case "$1" in
	purge)
		# the move's state (the pending migration, the old source files kept), unless the keyring's other name
		# is installed and still uses it: purging libretech-keyring during the rename, or later from its
		# config-files state, must not stop the migration or lose the originals
		if [ ! -e /usr/lib/libre-computer-archive-keyring/libre-computer-migrate ]; then
			rm -rf /var/lib/libre-computer-archive-keyring
		fi
		;;
	remove)
		# the timer libre-computer-move enabled, unless another package still ships it (the keyring's
		# other name takes the unit over in a rename: its retries must survive this removal)
		if [ ! -e /usr/lib/systemd/system/libre-computer-migrate.timer ]; then
			rm -f /etc/systemd/system/timers.target.wants/libre-computer-migrate.timer
		fi
		;;
esac
#DEBHELPER#
exit 0
