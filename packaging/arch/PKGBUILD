# libre-computer-keyring -- the OpenPGP key that signs the Libre Computer pacman repository.
# Built by build-arch.sh, which sets LC_VERSION and generates the three keyring files beside this file.
pkgname=libre-computer-keyring
pkgver=${LC_VERSION:?build with build-arch.sh}
pkgrel=1
pkgdesc='Libre Computer PGP keyring'
arch=(any)
url='https://packages.libre.computer/'
# the repository carries no license file yet; the operator names one
license=('LicenseRef-Not-Specified')
install=libre-computer-keyring.install
source=(libre-computer.gpg libre-computer-trusted libre-computer-revoked)
# generated by build-arch.sh from the one committed key file, not downloaded
sha256sums=(SKIP SKIP SKIP)

package() {
	install -Dm644 -t "$pkgdir/usr/share/pacman/keyrings" \
		libre-computer.gpg libre-computer-trusted libre-computer-revoked
}
