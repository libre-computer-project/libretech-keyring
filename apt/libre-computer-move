#!/bin/sh
# libre-computer-move -- run by the keyring package's postinst. A board still reading deb.libre.computer
# (the frozen repo) moves to packages.libre.computer: a source for its release is put in place (unless the
# board already has one), the deb.libre.computer entries are taken out of apt's sources (a file holding
# nothing else is set aside, an entry in a file with others is disabled in place, the original kept), and
# the one-shot rename migration (libre-computer-migrate) is scheduled for when apt is free. A board that
# cannot move -- a release packages.libre.computer does not serve, a kernel channel other than lc-lts, or
# packages.libre.computer not usable from here (unreachable, or apt rejecting it: signature, the board's
# clock) -- keeps its source and is told why. A board whose deb.libre.computer entries are all disabled is
# left alone.
#
# LC_PACKAGES_URI and LC_PACKAGES_KEY override the repository URI and the key the reachability check
# verifies it with (tests only: the source written always names the shipped key).
set -eu
# apt's and dpkg's messages untranslated: some are read below
export LC_ALL=C
URI=${LC_PACKAGES_URI:-https://packages.libre.computer/deb}
KEY=/usr/share/keyrings/libre-computer-deb.gpg
PROBE_KEY=${LC_PACKAGES_KEY:-$KEY}
# the repository without its scheme and its leading and trailing slashes: an entry naming it over http or https,
# or as file:/ for file:///, is the same repository to apt; compared whole (.../deb-testing is another one), the
# host in any case and the path as written (a server's paths are case-sensitive)
URIN=$(printf '%s' "$URI" | sed -E 's#^[A-Za-z][A-Za-z0-9+.-]*:##; s#^/+##; s#/+$##; s#/+#/#g')
URIN=$(printf '%s' "${URIN%%/*}" | tr 'A-Z' 'a-z')${URIN#"${URIN%%/*}"}
# the main list and the parts directory apt reads (a board may set them elsewhere)
SL=/etc/apt/sources.list SP=/etc/apt/sources.list.d
eval "$(apt-config shell SL Dir::Etc::sourcelist/f SP Dir::Etc::sourceparts/d 2>/dev/null)" || true
SP=${SP%/}
SRC=$SP/libre-computer.sources
STATE=/var/lib/libre-computer-archive-keyring
PKG=${DPKG_MAINTSCRIPT_PACKAGE:-}
if [ -z "$PKG" ]; then
	PKG=libretech-keyring
	! dpkg-query -W -f '${db:Status-Status}\n' libre-computer-archive-keyring 2>/dev/null | grep -qx installed ||
		PKG=libre-computer-archive-keyring
fi
say() { echo "libre-computer-archive-keyring: $*"; }
# still_ours: the keyring still on the board before this run writes into the state or the sources. Run by the
# migration (LC_MOVE_FROM_MIGRATE: its state and key there) or by dpkg-reconfigure (DEBCONF_RECONFIGURE: the
# key there, the package installed), the move holds no dpkg lock -- its probe, a network fetch, can take
# minutes, and it may wait for another move's lock -- so the owner may remove or purge the keyring meanwhile;
# that removal is theirs, and the move stops there, re-creating nothing. (From the postinst of an install or
# upgrade, dpkg holds its lock: nothing can remove the package)
# (dpkg-reconfigure sets DEBCONF_RECONFIGURE and not DPKG_RUNNING_VERSION, which dpkg sets for every maintainer
# script it runs: a postinst run by dpkg under a reconfigure's environment -- an install that reconfigure's own
# postinst started -- holds dpkg's lock and is not checked.) Once this move holds the move lock, the lock file
# must still be the one at its path: a purge deletes it with the state, and a reinstall meanwhile makes a new
# one that another move may lock (checked where /dev/fd works)
locked=0
still_ours() {
	if [ -n "${LC_MOVE_FROM_MIGRATE:-}" ]; then
		[ -d "$STATE" ] && [ -s "$KEY" ] || ours_gone
	elif [ -n "${DEBCONF_RECONFIGURE:-}" ] && [ -z "${DPKG_RUNNING_VERSION:-}" ]; then
		# (the package still on the board: installed, or left part-configured -- dpkg-reconfigure --force runs
		# the postinst of one a power loss cut short)
		# (one line per instance dpkg knows: a selection-only record of another architecture beside it is none)
		dpkg-query -W -f '${db:Status-Status}\n' "$PKG" 2>/dev/null |
			grep -qxE 'installed|half-configured|unpacked|triggers-awaited|triggers-pending' || ours_gone
		[ -s "$KEY" ] || ours_gone
	else
		return 0
	fi
	[ $locked = 0 ] && return 0
	# (/dev/fd, or /proc's own view of it where /dev/fd is missing; neither there: a root with no /proc)
	fd9=/dev/fd/9
	[ -e "$fd9" ] || fd9=/proc/self/fd/9
	[ ! -e "$fd9" ] || [ "$fd9" -ef "$STATE/.move.lock" ] || ours_gone
}
ours_gone() {
	say "the keyring was removed meanwhile; stopping, nothing more changed"
	exit 0
}
# timer_on: the migration's timer enabled, its link on disk (the link's directory synced: nothing else syncs
# /etc/systemd, and a filesystem that does not keep metadata in order could otherwise keep a later change --
# the old sources' removal -- and lose the link), and started now where systemd runs (--no-block)
timer_on() {
	# (offline, --root=/: the link written here, never by asking a running systemd -- in an image build with the
	# build host's /run bound in and no /proc, systemd 252 cannot see the chroot and would ask the host's)
	systemctl --root=/ enable libre-computer-migrate.timer >/dev/null 2>&1 || true
	sync /etc/systemd/system/timers.target.wants /etc/systemd/system 2>/dev/null || sync
	! live_systemd || systemctl start --no-block libre-computer-migrate.timer >/dev/null 2>&1 || true
}
# live_systemd: this root's own systemd runs (units may be started now): systemd's runtime directory, a /proc,
# and not a chroot. An image build in a chroot never starts units, even with the build host's /run bound in:
# without /proc, systemd-detect-virt cannot see a chroot (before systemd 253), so no /proc counts as one
live_systemd() {
	[ -d /run/systemd/system ] && [ -e /proc/1/comm ] && ! systemd-detect-virt --chroot --quiet 2>/dev/null
}
# in_chroot: an image being built (a chroot, or no /proc at all)
in_chroot() { [ ! -e /proc/1/comm ] || systemd-detect-virt --chroot --quiet 2>/dev/null; }

# one-line (.list) entries, read by field as apt reads them: TYPE [OPTIONS] URI SUITE COMPONENTS, a # starting a
# comment (a whole line, or the rest of one). Only the URI decides whose entry it is -- not a signed-by path or
# a trailing comment that mentions a repository. ours: active entries for the frozen repo; other: active
# entries for any other repository, or commented-out entries (content that must stay); new: an active deb
# entry for packages.libre.computer and the board's suite; disable: the file with ours commented out
list_awk() { # MODE FILE
	awk -v mode="$1" -v new="$URIN" -v suite="$suite" '
		# (a path naming it first -- a caching proxy, or a local mirror of the frozen repo -- counts too)
		# the path after a caching proxy host, its HTTPS/// (the apt-cacher-ng form for an https repo) taken off
		# (the host it names in any case, the path as written: paths on a server are case-sensitive)
		function proxied(u,   i) {
			sub(/^[A-Za-z][A-Za-z0-9+.-]*:\/*/, "", u)
			if (!index(u, "/")) return ""
			u = substr(u, index(u, "/") + 1); sub(/^\/+/, "", u); sub(/^[Hh][Tt][Tt][Pp][Ss]?\/+/, "", u); sub(/\/+$/, "", u); gsub(/\/+/, "/", u)
			i = index(u, "/")
			return i ? tolower(substr(u, 1, i - 1)) substr(u, i) : tolower(u)
		}
		function isours(u,   p, h, r) {
			r = proxied(u)
			u = tolower(u); sub(/^[a-z][a-z0-9+.-]*:\/*/, "", u)
			split(u, p, "/"); h = p[1]; sub(/^.*@/, "", h); sub(/:.*$/, "", h)
			split(r, p, "/")
			return h == "deb.libre.computer" || p[1] == "deb.libre.computer"
		}
		# (the host in any case, the path as written)
		function norm(u,   p, h, r) {
			sub(/^[A-Za-z][A-Za-z0-9+.-]*:/, "", u); sub(/^\/+/, "", u); sub(/\/+$/, "", u)
			h = u; r = ""
			if (index(u, "/")) { h = substr(u, 1, index(u, "/") - 1); r = substr(u, index(u, "/")) }
			sub(/^.*@/, "", h); sub(/:[0-9]+$/, "", h); gsub(/\/+/, "/", r)
			return tolower(h) r
		}
		# the new repository, directly or through a caching proxy whose path names it first
		function isnew(u) { return norm(u) == new || proxied(u) == new }
		{ sub(/\r$/, "") }
		{
			raw = $0; body = $0
			commented = (body ~ /^[[:space:]]*#/)
			if (commented) sub(/^[[:space:]]*#+[[:space:]]*/, "", body)
			# the options are the [ ... ] right after the type (a # in them is kept, as apt keeps it; a bracketed
			# IPv6 host in the URI stays); a # after them starts the comment
			sub(/^[[:space:]]+/, "", body)
			if (match(body, /^[^[:space:]]+[[:space:]]+\[[^]]*\]/)) {
				opt = substr(body, 1, RLENGTH); sub(/\[[^]]*\]$/, " ", opt)
				rest = substr(body, RLENGTH + 1); sub(/#.*$/, "", rest)
				body = opt rest
			} else sub(/#.*$/, "", body)
			ntok = split(body, t, /[[:space:]]+/); k = 0
			for (i = 1; i <= ntok; i++) if (t[i] != "") a[++k] = t[i]
			type = (k >= 1) ? a[1] : ""; uri = (k >= 2) ? a[2] : ""; dist = (k >= 3) ? a[3] : ""
			gsub(/"/, "", uri); gsub(/"/, "", dist)
			entry = (type == "deb" || type == "deb-src") && uri != ""
			libre = entry && isours(uri)
			if (entry && mode == "ours" && !commented && libre) c++
			if (entry && mode == "other" && (commented || !libre)) c++
			isn = entry && !commented && type == "deb" && isnew(uri) && dist != "" && dist == suite
			if (mode == "new" && isn) c++
			if (mode == "anynew" && entry && !commented && type == "deb" && isnew(uri)) c++
			if (mode == "pick" && isn) print raw
			if (mode == "disable") {
				if (entry && !commented && libre) print "# moved to packages.libre.computer: " raw
				else print raw
			}
		}
		END { if (mode != "disable" && mode != "pick") print c + 0 }
	' "$2"
}
# deb822 (.sources) stanzas, parsed as apt 3 does: only an empty line ends a stanza (a line of white space
# continues the field before it; a CRLF file's carriage returns are dropped first, as apt drops them), and Enabled: is false for no / false / without / off / disable / 0 (apt's
# StringToBool). A stanza's URIs may name several repositories. ours: enabled stanzas naming the frozen repo;
# other: stanzas naming any other repository, disabled ones naming ours, or commented-out entries (content
# that must stay); ours / other decided by the URI's host (deb.libre.computer, or first in a caching proxy's
# path); new:
# enabled stanzas naming packages.libre.computer for the board's suite (what remains of a stanza once the
# frozen repo is taken out of it counts: the stanza stays a source); disable: the file with the frozen repo taken out of each
# enabled stanza (the stanza disabled when it named nothing else, its other URIs kept when it did)
sources_awk() { # MODE FILE
	awk -v mode="$1" -v new="$URIN" -v suite="$suite" '
		# (a path naming it first -- a caching proxy, or a local mirror of the frozen repo -- counts too)
		# the path after a caching proxy host, its HTTPS/// (the apt-cacher-ng form for an https repo) taken off
		# (the host it names in any case, the path as written: paths on a server are case-sensitive)
		function proxied(u,   i) {
			sub(/^[A-Za-z][A-Za-z0-9+.-]*:\/*/, "", u)
			if (!index(u, "/")) return ""
			u = substr(u, index(u, "/") + 1); sub(/^\/+/, "", u); sub(/^[Hh][Tt][Tt][Pp][Ss]?\/+/, "", u); sub(/\/+$/, "", u); gsub(/\/+/, "/", u)
			i = index(u, "/")
			return i ? tolower(substr(u, 1, i - 1)) substr(u, i) : tolower(u)
		}
		function isours(u,   p, h, r) {
			r = proxied(u)
			u = tolower(u); sub(/^[a-z][a-z0-9+.-]*:\/*/, "", u)
			split(u, p, "/"); h = p[1]; sub(/^.*@/, "", h); sub(/:.*$/, "", h)
			split(r, p, "/")
			return h == "deb.libre.computer" || p[1] == "deb.libre.computer"
		}
		# (the host in any case, the path as written)
		function norm(u,   p, h, r) {
			sub(/^[A-Za-z][A-Za-z0-9+.-]*:/, "", u); sub(/^\/+/, "", u); sub(/\/+$/, "", u)
			h = u; r = ""
			if (index(u, "/")) { h = substr(u, 1, index(u, "/") - 1); r = substr(u, index(u, "/")) }
			sub(/^.*@/, "", h); sub(/:[0-9]+$/, "", h); gsub(/\/+/, "/", r)
			return tolower(h) r
		}
		# the new repository, directly or through a caching proxy whose path names it first
		function isnew(u) { return norm(u) == new || proxied(u) == new }
		function flush(   k, t, ntok, keep, libre, oth, mine, hs, hd, hn) {
			if (n == 0) return
			# Enabled: the whole field, continuation lines included; false as apt reads it
			if (ev != "") {
				sub(/^[[:space:]]+/, "", ev); sub(/[[:space:]]+$/, "", ev)
				off = (ev ~ /^(no|false|without|off|disable|[+-]?(0[xXbB])?0+)$/)
			}
			v = uris; sub(/^[^:]*:/, "", v)
			ntok = split(v, t, /[[:space:]]+/); keep = ""; libre = 0; oth = 0
			for (k = 1; k <= ntok; k++) {
				if (t[k] == "") continue
				if (isours(t[k])) libre = 1
				else { oth = 1; keep = keep " " t[k] }
			}
			mine = libre && !off
			if (mode == "ours" && mine) c++
			if (mode == "other" && (oth || (off && libre) || cent)) c++
			# (the empty field a leading space splits into is no suite: with none served, suite is empty too)
			hs = 0
			ntok = split(suites, t, /[[:space:]]+/)
			for (k = 1; k <= ntok; k++) if (t[k] != "" && t[k] == suite) hs = 1
			hd = 0
			ntok = split(types, t, /[[:space:]]+/)
			for (k = 1; k <= ntok; k++) if (t[k] == "deb") hd = 1
			hn = 0
			ntok = split(v, t, /[[:space:]]+/)
			for (k = 1; k <= ntok; k++) if (t[k] != "" && isnew(t[k])) hn = 1
			if (mode == "new" && !off && hn && hs && hd) c++
			if (mode == "anynew" && !off && hn && hd) c++
			if (mode == "pick" && !off && hn && hs && hd) { for (k = 1; k <= n; k++) print line[k]; print "" }
			if (mode == "disable") {
				for (k = 1; k <= n; k++) {
					if (mine && oth && isuri[k]) continue
					if (mine && !oth && isen[k]) continue
					print line[k]
				}
				if (mine && oth) print "URIs:" keep
				if (mine && !oth) print "Enabled: no"
				print ""
			}
			n = 0; uris = ""; suites = ""; types = ""; off = 0; field = ""; cent = 0; ev = ""
			split("", isuri); split("", isen)
		}
		{ sub(/\r$/, "") }
		/^$/ { flush(); next }
		/^#/ {
			line[++n] = $0
			if (tolower($0) ~ /^#+[[:space:]]*((types|uris|suites)[[:space:]]*:|deb(-src)?[[:space:]])/) cent = 1
			next
		}
		{
			line[++n] = $0
			l = tolower($0)
			# a continuation line (white space first): part of the field before it
			if (l ~ /^[[:space:]]/) {
				if (field == "uris") { uris = uris " " $0; isuri[n] = 1 }
				if (field == "suites") suites = suites " " $0
				if (field == "types") types = types " " $0
				if (field == "enabled") { c2 = l; sub(/^[[:space:]]+/, "", c2); ev = ev "\n" c2; isen[n] = 1 }
				next
			}
			field = l; sub(/[[:space:]]*:.*/, "", field)
			if (field == "uris") { uris = $0; isuri[n] = 1 }
			if (field == "suites") { suites = $0; sub(/^[^:]*:/, "", suites) }
			if (field == "types") { types = $0; sub(/^[^:]*:/, "", types) }
			if (field == "enabled") { ev = l; sub(/^[^:]*:/, "", ev); if (ev == "") ev = " "; isen[n] = 1 }
		}
		END { flush(); if (mode != "disable" && mode != "pick") print c + 0 }
	' "$2"
}
count() { # MODE FILE: entries of that kind in one sources file, either format
	case $2 in
		*.sources) sources_awk "$1" "$2" ;;
		*) list_awk "$1" "$2" ;;
	esac
}

# the board's suite on packages.libre.computer, if it has one
. /etc/os-release
case "${ID:-}:${VERSION_CODENAME:-}" in
	debian:bookworm|debian:trixie|ubuntu:noble|ubuntu:resolute) suite=$VERSION_CODENAME ;;
	# Raspbian 12 (armhf) reads Debian 12's suite: every package but the kernel is Architecture: all,
	# and the armhf kernel is ARMv7, which these boards are
	raspbian:bookworm) suite=bookworm ;;
	*) suite="" ;;
esac

# the files with an enabled entry for the frozen repo, and whether the board already reads the new one
# one move at a time (the timer's run and a dpkg-reconfigure or a keyring upgrade can meet): the second waits,
# then finds the board moved and has nothing to do
still_ours
mkdir -p "$STATE"; sync "$STATE" "${STATE%/*}" 2>/dev/null || sync
exec 9>"$STATE/.move.lock"
flock 9
locked=1
# (and again after the wait for another move)
still_ours
T="" tmp=""
trap '[ -z "$T" ] || rm -rf "$T"; [ -z "$tmp" ] || rm -f "$tmp"' EXIT
trap 'exit 1' INT TERM HUP
# every temporary file beside a source (sources.list.d, sources.list, a file a symlink names) is named in TEMPS
# before it exists: one a power loss left (the trap above never ran; apt notes such a file on every run) is
# removed by the next run, here, under the lock -- only the paths listed, never a file of the owner's
TEMPS=$STATE/temps
newtmp() { # PATH [name]: tmp set to a fresh name beside PATH, listed, then created empty (with "name": not
	# created, for cp -P to make)
	tmp=$(mktemp -u "$1.libre-computer-move.XXXXXX")
	printf '%s\n' "$tmp" >> "$TEMPS"
	# (the list on disk before the file exists, its directory entry too)
	sync "$TEMPS" "$STATE" 2>/dev/null || sync
	[ "${2:-}" = name ] || (set -C; : > "$tmp")
}
if [ -s "$TEMPS" ]; then
	while IFS= read -r t; do
		case $t in *.libre-computer-move.??????) rm -f "$t"; sync "${t%/*}" 2>/dev/null || sync ;; esac
	done < "$TEMPS"
fi
# (each removal on disk, its directory synced, before the list that names it goes)
rm -f "$TEMPS"

# step 1 below puts the new source in place, then asks apt whether it can still read the sources, and puts the
# previous file back if not. The check's record (C) is written before the new file goes in and removed once the
# check is done: a move stopped in between (or an undo that failed) is checked here, by the next run
C=$STATE/sources-check
undo_src() { # KIND BACKUP PATH: the previous libre-computer.sources back (file: its copy at PATH, which a
	# symlink named; link: the link itself; none: there was none)
	case $1 in
	file)
		newtmp "$3"
		cp -p "$2" "$tmp"
		# (on disk before the rename over the file apt cannot read)
		sync "$tmp" 2>/dev/null || sync
		mv -T "$tmp" "$3"
		tmp=""
		sync "${3%/*}" 2>/dev/null || sync ;;
	link)
		newtmp "$SRC" name
		cp -P "$2" "$tmp"
		mv -T "$tmp" "$SRC"
		tmp=""
		sync "${SRC%/*}" 2>/dev/null || sync ;;
	*)
		rm -f "$SRC"
		sync "${SRC%/*}" 2>/dev/null || sync ;;
	esac
	# (the restore on disk -- its directory's entry -- before the caller deletes the backup and the check record,
	# which may sit on another filesystem: /var and /etc commit apart)
}
new_errors() { # BEFORE AFTER: the E: lines apt prints now and did not before
	grep '^E:' "$2" | grep -vxF -f "$1"
}
say_unreadable() { # LOG
	say "apt cannot read the sources with packages.libre.computer added beside the board's own entry for it; staying on deb.libre.computer for now, and trying again every 6 hours. apt said:"
	grep -E '^(E|W):' "$1" | sed 's/^/  /' || true
}
unreadable() { # LOG: say so, and the previous source back (its copy, now the file again, not kept twice)
	ub=$(cat "$C/backup")
	undo_src "$(cat "$C/kind")" "$ub" "$(cat "$C/path")"
	# (step 1 undone: this run moved nothing, so "moving" is what it was before -- an earlier run's part-way move,
	# whose stanza the undo has put back, or none)
	if [ -e "$C/moving" ]; then
		cp "$C/moving" "$STATE/moving"
		sync "$STATE/moving" 2>/dev/null || sync
	else
		rm -f "$STATE/moving"
	fi
	# the record before the backup it names, on disk first: a power loss between the two never leaves a
	# record whose backup is gone (the next run's undo would have nothing to copy back)
	rm -rf "$C"
	sync "$STATE" 2>/dev/null || sync
	[ -z "$ub" ] || rm -f "$ub"
	say_unreadable "$1"
	exit 0
}
if [ -s "$C/kind" ]; then
	T=$(mktemp -d)
	apt-get -q -o Dir::Cache="$T" indextargets >/dev/null 2>"$T/after.log" || true
	! new_errors "$C/before.log" "$T/after.log" >/dev/null || unreadable "$T/after.log"
	rm -rf "$C" "$T"
	T=""
fi

# (has_any: an enabled entry for packages.libre.computer for any suite -- the board reads it whatever its release)
old="" has_new=0 has_any=0 newfiles=""
for f in "$SL" "$SP"/*.list "$SP"/*.sources; do
	[ -f "$f" ] || continue
	# only a file apt reads: it skips a name with any character outside letters, digits, _ - . : (so no
	# name with a space reaches the loops below)
	case ${f##*/} in *[!A-Za-z0-9_.:-]*) continue ;; esac
	# (a count awk could not make, e.g. of a file root cannot read, counts as none)
	if [ "$(count new "$f")" -gt 0 ] 2>/dev/null; then has_new=1; newfiles="$newfiles $f"; fi
	if [ "$(count anynew "$f")" -gt 0 ] 2>/dev/null; then has_any=1; fi
	[ "$(count ours "$f")" -gt 0 ] || continue
	old="$old $f"
done
# move-pending: a move the timer retries (packages.libre.computer was not usable at the last try)
retry_off() { rm -f "$STATE/move-pending"; }
# stay REASON: the board does not move, saying why, and exits. A move part-way ("stepped": its packages.libre.computer
# source in, deb.libre.computer's entries left) keeps its retry mark: the board reads both repositories, and the
# move finishes at a run that finds the reason gone, or the deb.libre.computer entries gone. (No advice on what to
# remove to stay: which files hold what after a cut-short move is the move's to know, and the owner's sources are
# theirs.) Not stepped: nothing changes, and the marks of a migration that cannot run go (unmoved)
stay() {
	if [ $stepped = 1 ]; then
		# (the retry mark and its timer, whatever an earlier run left: this is reached only with systemd)
		touch "$STATE/move-pending" || exit 1; sync "$STATE/move-pending" "$STATE" 2>/dev/null || sync
		timer_on
		say "$1; an earlier move, cut short, left packages.libre.computer's source beside deb.libre.computer's entries. Both stay; this is checked again every 6 hours, and the move finishes once that no longer holds or the deb.libre.computer entries are gone"
	else
		say "$1; staying on deb.libre.computer"
		retry_off
		unmoved
	fi
	exit 0
}
# unmoved: a board that stays and reads no packages.libre.computer entry for any suite (has_any 0) has no migration
# to run: the marks an earlier, cut-short move left (step 2's, its source since removed by the owner) go, synced,
# so no timer runs a migration that cannot (its rename records stay, for the move that comes later)
unmoved() {
	[ $has_any = 0 ] || return 0
	rm -f "$STATE/migrate-pending" "$STATE/moved" "$STATE/kernel-pending"
	sync "$STATE" 2>/dev/null || sync
}
# "moving": step 1 below wrote the new source over libre-computer.sources (written, synced, before the rename;
# gone once step 3 is done). A run stopped after that rename and before step 2's marks were on disk leaves a
# board with no deb.libre.computer entry left -- every one was in that file -- and nothing scheduled: so a run
# that finds nothing to move, with the mark still there, finishes step 2 (the migration pending, its timer on)
# (only with the new stanza in libre-computer.sources itself, the file step 1 writes: a mark a run stopped
# before its rename left, the old file still in place, claims nothing and goes, whatever entry of the owner's
# names packages.libre.computer elsewhere)
# (the stanza for the suite the mark names, which that run wrote: the owner may have upgraded the board to another
# release since; a mark that names none, from an older version, means this run's suite)
# (Like every source of the board's, that stanza is the owner's to carry through a release upgrade: the move
# never rewrites a suite once written)
# ("own": a move through the board's own entry for packages.libre.computer, which writes no source; marked at
# step 2 and part-way while that entry is still read)
stepped=0 ms=""
if [ -e "$STATE/moving" ]; then
	ms=$(cat "$STATE/moving" 2>/dev/null || true)
	# (that suite's stanza, or the current suite's: an owner's release upgrade may have edited the stanza too)
	if [ "$ms" = own ]; then
		[ $has_any = 1 ] && stepped=1 || rm -f "$STATE/moving"
	elif [ -f "$SRC" ] && { [ "$(suite=${ms:-$suite}; count new "$SRC")" -gt 0 ] 2>/dev/null ||
		[ "$(count new "$SRC")" -gt 0 ] 2>/dev/null; }; then
		stepped=1
	else
		rm -f "$STATE/moving"
	fi
fi
# the renames are run by a systemd timer: a board whose init is not systemd (sysvinit-core, openrc) would be
# moved with nothing ever to rename its packages, so it stays. Read from /sbin/init, not from a running
# systemd: an image being built in a chroot has none running, and boots with it. No /sbin/init yet (an image
# build that adds its init after this package) counts as systemd when systemd itself is installed. Checked
# before a part-way move is finished too: its renames could not run either
init=none
[ ! -e /sbin/init ] || init=$(readlink -f /sbin/init 2>/dev/null || echo /sbin/init)
case $init in
	*/systemd) ;;
	# (no /sbin/init, or a dangling one: systemd's, only while an image is being built -- a chroot, or systemd
	# itself running -- with systemd installed; a running system with some other PID 1, a container, is not)
	none)
		if { [ -x /usr/lib/systemd/systemd ] || [ -x /lib/systemd/systemd ]; } &&
			{ in_chroot || [ -d /run/systemd/system ]; }; then
			:
		else
			init=none-and-no-systemd
		fi ;;
esac
case $init in
	*/systemd | none) ;;
	*)
		[ "$init" != none-and-no-systemd ] || init=none
		if [ $stepped = 1 ]; then
			# (nothing is finished here. "moving", the retry mark and the timer's link stay -- the link set again,
			# as a removal and reinstall of the package drops it, and enabling it is only a link on disk: no
			# timer runs without systemd -- so once the init is systemd the timer runs the move, which finishes it)
			touch "$STATE/move-pending" || exit 1; sync "$STATE/move-pending" "$STATE" 2>/dev/null || sync
			timer_on
			say "this board's init ($init) is not systemd, which runs the renames, so the move cut short earlier is not finished: the board reads packages.libre.computer's source, and the move and the renames wait until the init is systemd"
			exit 0
		fi
		if [ -n "$old" ]; then
			say "this board's init ($init) is not systemd, which runs the renames; staying on deb.libre.computer"
			retry_off
			unmoved
			exit 0
		fi ;;
esac

if [ -z "$old" ] && [ $stepped = 1 ]; then
	touch "$STATE/migrate-pending" "$STATE/moved"
	sync "$STATE/migrate-pending" "$STATE/moved" "$STATE" 2>/dev/null || sync
	rm -f "$STATE/moving"
	timer_on
	say "the move to packages.libre.computer was cut short after its new source went in; the renames are now pending"
fi
[ -n "$old" ] || { retry_off; exit 0; }

[ -n "$suite" ] || stay "this release (${ID:-unknown} ${VERSION_CODENAME:-unknown}) is not served by packages.libre.computer"

# a kernel channel packages.libre.computer does not carry keeps the board on the frozen repo (its meta-package in
# any state but removed: one a failed kernel upgrade left unpacked still names the channel)
others=$(dpkg-query -W -f '${db:Status-Status} ${Package}\n' 'linux-image-lc-*' 2>/dev/null |
	awk '$1 != "not-installed" && $1 != "config-files" {print $2}' |
	grep -E '^linux-image-lc-.+-(arm64|arm|armhf|amd64)$' |
	grep -vE '^linux-image-lc-lts-(arm64|arm|armhf|amd64)$' || true)
if [ -n "$others" ]; then
	# (stepped: also until the channel is lc-lts again, when the move finishes)
	stay "this board follows a kernel channel packages.libre.computer does not carry ($(echo $others))"
fi
# a directory where the new source would go: it cannot take its name (a stay like the others, before any mark
# is set)
[ $has_new = 1 ] || [ ! -d "$SRC" ] || stay "$SRC is a directory; the new source cannot take its name"

# the board is to move: from here on, any failure (a full /tmp, a probe) leaves the mark the timer retries,
# cleared once the move is done or found impossible
touch "$STATE/move-pending" || exit 1; sync "$STATE/move-pending" "$STATE" 2>/dev/null || sync
timer_on

ARCH=$(dpkg --print-architecture)
T=$(mktemp -d)
# the scratch probes run none of apt's update hooks (appstream, packagekit, command-not-found): they would
# refresh the system's caches from inside the postinst
printf '#clear APT::Update::Pre-Invoke;\n#clear APT::Update::Post-Invoke;\n#clear APT::Update::Post-Invoke-Success;\n#clear APT::Update::Post-Invoke-Stats;\n#clear APT::Update::Auth-Failure;\n' > "$T/nohooks.conf"
chmod 755 "$T"
stanza() { # KEY: the new source's stanza
	printf 'Types: deb\nURIs: %s\nSuites: %s\nComponents: main non-free\nSigned-By: %s\n' "$URI" "$suite" "$1"
}

# packages.libre.computer must be usable from here before anything changes, through the source the board
# will read: the shipped stanza (checked here), or the board's own entry for it (checked below, and then
# the shipped stanza is not needed: an http-only path is fine for an http entry). apt itself updates the new
# source alone into scratch lists (apt's proxy settings apply; it checks the signature, and the Release
# date against the board's clock). A proxy or an egress allowlist can admit only the old host
if [ $has_new = 0 ]; then
	mkdir -p "$T/parts" "$T/lists/partial" "$T/cache/archives/partial"
	! id _apt >/dev/null 2>&1 || chown _apt "$T/lists/partial" "$T/cache/archives/partial"
	stanza "$PROBE_KEY" > "$T/parts/probe.sources"
	if ! apt-get -q -c "$T/nohooks.conf" -o Dir::Etc::SourceList=/dev/null -o Dir::Etc::SourceParts="$T/parts" \
		-o Dir::State::Lists="$T/lists" -o Dir::Cache="$T/cache" update >"$T/probe.log" 2>&1 ||
		! ls "$T/lists/" 2>/dev/null | grep -q 'InRelease$' ||
		! ls "$T/lists/" 2>/dev/null | grep -q "_dists_${suite}_main_binary-${ARCH}_Packages"; then
		say "packages.libre.computer ($URI) is not usable from this board; staying on deb.libre.computer for now, and trying again every 6 hours (or run 'dpkg-reconfigure $PKG'). apt said:"
		grep -E '^(E|W|Err):' "$T/probe.log" | sed 's/^/  /' || true
		# a network or clock fault at upgrade time must not leave the board on the frozen repo for good
		still_ours
		mkdir -p "$STATE"; sync "$STATE" "${STATE%/*}" 2>/dev/null || sync
		touch "$STATE/move-pending" || exit 1; sync "$STATE/move-pending" "$STATE" 2>/dev/null || sync
		timer_on
		exit 0
	fi
fi

# a board that already has an entry for packages.libre.computer keeps it (step 1 writes none): that entry,
# with its own key, must work too, or the board would be left with no working Libre Computer source once the
# old entries go. apt updates those files alone into scratch lists; the new repository's InRelease must be in
if [ $has_new = 1 ]; then
	mkdir -p "$T/own" "$T/ownlists/partial" "$T/owncache/archives/partial"
	! id _apt >/dev/null 2>&1 || chown _apt "$T/ownlists/partial" "$T/owncache/archives/partial"
	i=0
	for f in $newfiles; do
		i=$((i + 1))
		case $f in
			*.sources) sources_awk pick "$f" > "$T/own/$i.sources" ;;
			*) list_awk pick "$f" > "$T/own/$i.list" ;;
		esac
	done
	apt-get -q -c "$T/nohooks.conf" -o Dir::Etc::SourceList=/dev/null -o Dir::Etc::SourceParts="$T/own" \
		-o Dir::State::Lists="$T/ownlists" -o Dir::Cache="$T/owncache" update >"$T/own.log" 2>&1 || true
	# the InRelease, and main for this board's architecture (an entry with only non-free, or for another
	# architecture, would leave nothing serving the renamed packages)
	# (apt keeps the host's case in its list file names, so compared without case; every slash is an underscore
	# there, a doubled one too, so runs of them match; dots literal; an explicit port, which apt keeps in the
	# name as host:port, may follow the host)
	want=$(printf '%s' "$URIN" | sed 's/[.]/[.]/g; s#/#(:[0-9]+)?/#; s#/#_+#g')_+dists_${suite}
	if ! ls "$T/ownlists/" 2>/dev/null | grep -qiE -- "${want}_InRelease" ||
		! ls "$T/ownlists/" 2>/dev/null | grep -qiE -- "${want}_main_binary-${ARCH}_Packages"; then
		say "the board's own entry for packages.libre.computer is not usable (its key, or the network); staying on deb.libre.computer for now, and trying again every 6 hours. apt said:"
		grep -E '^(E|W|Err):' "$T/own.log" | sed 's/^/  /' || true
		still_ours
		mkdir -p "$STATE"; sync "$STATE" "${STATE%/*}" 2>/dev/null || sync
		touch "$STATE/move-pending" || exit 1; sync "$STATE/move-pending" "$STATE" 2>/dev/null || sync
		timer_on
		exit 0
	fi
fi

still_ours
mkdir -p "$STATE/moved-sources"
stamp=$(date +%Y%m%d%H%M%S)
backup() { # FILE: the path its original is kept at, never one already taken
	b=$STATE/moved-sources/$(basename "$1") n=0
	while [ -e "$b" ] || [ -L "$b" ]; do n=$((n + 1)); b=$STATE/moved-sources/$(basename "$1").$stamp.$n; done
	echo "$b"
}

# a failure from here on (a full disk, a failed copy) is retried by the timer: the mark is set before anything
# changes and cleared once the move is done
touch "$STATE/move-pending" || exit 1; sync "$STATE/move-pending" "$STATE" 2>/dev/null || sync
timer_on

# 1. the new source in place first, so the board never lacks one (a full disk stops here, before anything
# changed). A board that already reads packages.libre.computer keeps its own entry: a second one with a
# different Signed-By would make apt refuse every source. libre-computer.sources holding entries of its
# own keeps them: ours in it are disabled and the new stanza added after them
if [ $has_new = 0 ]; then
	# a regular file (or a link to one) is read and kept; anything else there (a link to /dev/null, which
	# switches a file off, a dangling link) is set aside as it is and the new file takes its name
	if [ ! -f "$SRC" ] || { [ "$(count other "$SRC")" -eq 0 ] && [ "$(count ours "$SRC")" -gt 0 ]; }; then
		stanza "$KEY" > "$T/src"
	else
		sources_awk disable "$SRC" > "$T/src"
		stanza "$KEY" >> "$T/src"
	fi
	# what apt says of the sources now: a source it refuses after the change, and did not before, is ours to undo
	mkdir -p "$T/icache"
	apt-get -q -o Dir::Cache="$T/icache" indextargets >/dev/null 2>"$T/before.log" || true
	# asked first of a copy of the sources with the new file in it: a board whose sources apt would refuse
	# keeps its own untouched (nothing written, no copy kept; the timer asks again). apt names the copy's
	# files in what it says, so the copy's directory is read as the real one. (A directory of its own: the
	# probe's $T/parts holds the probe stanza)
	# Each file's content, through any symlink (a relative link would dangle in the copy, and apt skips a
	# dangling link without a word); what is not a readable file (a dangling link, a link to /dev/null) apt
	# reads as nothing, and the copy leaves out
	mkdir "$T/withnew"
	for f in "$SP"/*; do
		[ -f "$f" ] && [ "${f##*/}" != "${SRC##*/}" ] || continue
		cat "$f" > "$T/withnew/${f##*/}"
	done
	cp "$T/src" "$T/withnew/${SRC##*/}"
	apt-get -q -o Dir::Cache="$T/icache" -o Dir::Etc::SourceParts="$T/withnew" indextargets >/dev/null 2>"$T/pre.raw" || true
	awk -v a="$T/withnew" -v b="$SP" '{
		o = ""
		while ((i = index($0, a)) > 0) { o = o substr($0, 1, i - 1) b; $0 = substr($0, i + length(a)) }
		print o $0
	}' "$T/pre.raw" > "$T/pre.log"
	if new_errors "$T/before.log" "$T/pre.log" >/dev/null; then
		say_unreadable "$T/pre.log"
		exit 0
	fi
	src_backup="" src_link=""
	if [ -f "$SRC" ]; then
		src_backup=$(backup "$SRC")
		cp -p "$SRC" "$src_backup"
	elif [ -L "$SRC" ]; then
		src_link=$(backup "$SRC")
		cp -P "$SRC" "$src_link"
	fi
	# into the file itself, or the regular file a symlink names (the link stays a link)
	real_src=$SRC
	[ ! -L "$SRC" ] || [ ! -f "$SRC" ] || real_src=$(readlink -f "$SRC")
	# an existing file's mode and owner kept; the temporary file has a fresh name (never an existing file or link)
	newtmp "$real_src"
	cat "$T/src" > "$tmp"
	if [ -f "$real_src" ]; then
		chmod --reference="$real_src" "$tmp"
		chown --reference="$real_src" "$tmp"
		# readable to every user too (apt run as a normal user reads the sources)
		chmod a+r "$tmp"
	else
		# a new file readable to every user (apt as a normal user reads the sources), whatever the umask
		chmod 0644 "$tmp"
	fi
	# the check's record, before the new file goes in (kind last: its presence starts the check)
	rm -rf "$C"
	mkdir -p "$C"
	cp "$T/before.log" "$C/before.log"
	printf '%s' "$real_src" > "$C/path"
	if [ -n "$src_backup" ]; then
		printf '%s' "$src_backup" > "$C/backup"
		kind=file
	elif [ -n "$src_link" ]; then
		printf '%s' "$src_link" > "$C/backup"
		kind=link
	else
		: > "$C/backup"
		kind=none
	fi
	# the rest of the record, the copy of the previous file (what an undo puts back) and the new file's content
	# on disk first; then kind, on disk too, so a record whose kind is there is whole. $STATE as well: the
	# entries of sources-check and move-pending, which may be on another filesystem than the source
	# ("moving" too: see where it is read, after the scan for old entries)
	# (the suite it writes: the board may move to another release before a run finds the mark; an earlier
	# run's mark, a part-way move this run redoes, is kept in the record for an undo to put back)
	cm=""
	[ ! -e "$STATE/moving" ] || { cp "$STATE/moving" "$C/moving"; cm=$C/moving; }
	echo "$suite" > "$STATE/moving"
	sync "$C/before.log" "$C/path" "$C/backup" ${cm:+"$cm"} "$C" "$tmp" ${src_backup:+"$src_backup"} \
		${src_link:+"$src_link"} "$STATE/moved-sources" "$STATE/moving" "$STATE" 2>/dev/null || sync
	echo "$kind" > "$C/kind"
	sync "$C/kind" "$C" 2>/dev/null || sync
	# then the rename: a power loss finds the old file or the new one whole, never an empty one
	mv -T "$tmp" "$real_src"
	tmp=""
	# apt judges the sources as a whole: an entry of the board's own for packages.libre.computer in a shape
	# this script does not recognise (another scheme, deb-src only, another Signed-By) can make apt refuse
	# every source beside the new one. Then nothing has changed yet: the previous file comes back
	apt-get -q -o Dir::Cache="$T/icache" indextargets >/dev/null 2>"$T/after.log" || true
	! new_errors "$C/before.log" "$T/after.log" >/dev/null || unreadable "$T/after.log"
	rm -rf "$C"
fi

# 2. the migration pending and its timer enabled, before the old entries go: an interruption from here
# leaves both sources (apt reads both) and the migration still runs. The new source and these marks on disk
# first (its directory too: the rename that put it there), so a power loss after the old entries go cannot
# leave the board with neither
touch "$STATE/migrate-pending" "$STATE/moved"
ns=${real_src:-$SRC}
if [ $has_new = 0 ]; then
	sync "$ns" "${ns%/*}" "$STATE/migrate-pending" "$STATE/moved" "$STATE" 2>/dev/null || sync
else
	# the board's own entry for packages.libre.computer stays the source: its files and their directories on
	# disk too (one may be the file an earlier run renamed in and was stopped before syncing). "moving" (own):
	# a stop in step 3 leaves a part-way move, as step 1's mark does on the other path
	echo own > "$STATE/moving"
	# shellcheck disable=SC2086
	sync $newfiles $(for nf in $newfiles; do printf '%s ' "${nf%/*}"; done) \
		"$STATE/migrate-pending" "$STATE/moved" "$STATE/moving" "$STATE" 2>/dev/null || sync
fi

# 3. the deb.libre.computer entries out
for f in $old; do
	# libre-computer.sources was rewritten in step 1, unless the board already had the new source
	[ $has_new = 1 ] || [ "$f" != "$SRC" ] || continue
	case $f in
		"$SL") whole=0 ;;
		*) [ "$(count other "$f")" -eq 0 ] && whole=1 || whole=0 ;;
	esac
	if [ $whole = 1 ]; then
		# a symlink: the backup holds the content it named (a relative link would dangle there), and the
		# link goes; the file it named stays where it is
		# (the copy on disk before the original goes: /var and /etc may be different filesystems, where mv is
		# a copy and an unlink)
		b=$(backup "$f")
		cp -pL "$f" "$b"
		sync "$b" "${b%/*}" 2>/dev/null || sync
		rm -f "$f"
		# (the removal on disk before the retry mark goes, which may be on another filesystem)
		sync "${f%/*}" 2>/dev/null || sync
		continue
	fi
	# a file with other entries too: the original kept, ours disabled in place -- in the file itself, or in
	# the file a symlink names (the link stays a link), through a copy renamed over it
	b=$(backup "$f")
	cp -p "$f" "$b"
	real=$(readlink -f "$f")
	case $f in
		*.sources) sources_awk disable "$f" > "$T/edited" ;;
		*) list_awk disable "$f" > "$T/edited" ;;
	esac
	newtmp "$real"
	cat "$T/edited" > "$tmp"
	chmod --reference="$real" "$tmp"
	chown --reference="$real" "$tmp"
	# the copy and the edited file on disk before the rename over the original (a filesystem that does not
	# flush a file renamed over another could otherwise leave it empty)
	sync "$b" "${b%/*}" "$tmp" 2>/dev/null || sync
	mv -T "$tmp" "$real"
	tmp=""
	sync "${real%/*}" 2>/dev/null || sync
done
retry_off
rm -f "$STATE/moving"
sync "$STATE" 2>/dev/null || sync
say "moved to packages.libre.computer ($suite); the old source files are in $STATE/moved-sources"

# 4. the renames need apt, which is busy until this install finishes: the timer retries until they are
# done, and a transient timer starts them 30 s from now
# (not in a chroot -- an image build -- even one with the build host's /run bound in: systemd-run, unlike
# systemctl, does not check, and would start the build host's own migration)
if live_systemd; then
	systemctl start --no-block libre-computer-migrate.timer >/dev/null 2>&1 || true
	systemd-run --quiet --no-block --on-active=30 --unit="libre-computer-migrate-now-$stamp-$$" \
		systemctl start --no-block libre-computer-migrate.service >/dev/null 2>&1 ||
		say "the renames run within minutes of the next boot"
else
	say "the renames run within minutes of the next boot"
fi
