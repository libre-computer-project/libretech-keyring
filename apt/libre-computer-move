#!/bin/sh
# libre-computer-move -- run by the keyring package's postinst. A board still reading deb.libre.computer
# (the frozen repo) moves to packages.libre.computer: a source for its release is put in place (unless the
# board already has one), the deb.libre.computer entries are taken out of apt's sources (a file holding
# nothing else is set aside, an entry in a file with others is disabled in place, the original kept), and
# the one-shot rename migration (libre-computer-migrate) is scheduled for when apt is free. A board that
# cannot move -- a release packages.libre.computer does not serve, a kernel channel other than lc-lts, or
# packages.libre.computer not usable from here (unreachable, or apt rejecting it: signature, the board's
# clock) -- keeps its source and is told why. A board whose deb.libre.computer entries are all disabled is
# left alone.
#
# LC_PACKAGES_URI and LC_PACKAGES_KEY override the repository URI and the key the reachability check
# verifies it with (tests only: the source written always names the shipped key).
set -eu
URI=${LC_PACKAGES_URI:-https://packages.libre.computer/deb}
KEY=/usr/share/keyrings/libre-computer-deb.gpg
PROBE_KEY=${LC_PACKAGES_KEY:-$KEY}
# the repository with its scheme taken off: an entry naming it over http or https is the same repository to apt
URIHOST=${URI#*://}
SRC=/etc/apt/sources.list.d/libre-computer.sources
STATE=/var/lib/libre-computer-archive-keyring
PKG=${DPKG_MAINTSCRIPT_PACKAGE:-libre-computer-archive-keyring}
say() { echo "libre-computer-archive-keyring: $*"; }

# one-line (.list) entries, read by field as apt reads them: TYPE [OPTIONS] URI SUITE COMPONENTS, a # starting a
# comment (a whole line, or the rest of one). Only the URI decides whose entry it is -- not a signed-by path or
# a trailing comment that mentions a repository. ours: active entries for the frozen repo; other: active
# entries for any other repository, or commented-out entries (content that must stay); new: an active deb
# entry for packages.libre.computer and the board's suite; disable: the file with ours commented out
list_awk() { # MODE FILE
	awk -v mode="$1" -v new="$URIHOST" -v suite="$suite" '
		{ sub(/\r$/, "") }
		{
			raw = $0; body = $0
			commented = (body ~ /^[[:space:]]*#/)
			if (commented) sub(/^[[:space:]]*#[[:space:]]*/, "", body)
			sub(/#.*$/, "", body)
			gsub(/\[[^]]*\]/, " ", body)
			ntok = split(body, t, /[[:space:]]+/); k = 0
			for (i = 1; i <= ntok; i++) if (t[i] != "") a[++k] = t[i]
			type = (k >= 1) ? a[1] : ""; uri = (k >= 2) ? a[2] : ""; dist = (k >= 3) ? a[3] : ""
			entry = (type == "deb" || type == "deb-src") && uri != ""
			libre = entry && uri ~ /deb\.libre\.computer/
			if (entry && mode == "ours" && !commented && libre) c++
			if (entry && mode == "other" && (commented || !libre)) c++
			if (entry && mode == "new" && !commented && type == "deb" && index(uri, new) && dist == suite) c++
			if (mode == "disable") {
				if (entry && !commented && libre) print "# moved to packages.libre.computer: " raw
				else print raw
			}
		}
		END { if (mode != "disable") print c + 0 }
	' "$2"
}
# deb822 (.sources) stanzas, parsed as apt 3 does: only an empty line ends a stanza (a line of white space
# continues the field before it; a CRLF file's carriage returns are dropped first, as apt drops them), and Enabled: is false for no / false / without / off / disable / 0 (apt's
# StringToBool). A stanza's URIs may name several repositories. ours: enabled stanzas naming the frozen repo;
# other: stanzas naming any other repository, or disabled ones naming ours (content that must stay); new:
# enabled stanzas naming packages.libre.computer for the board's suite (what remains of a stanza once the
# frozen repo is taken out of it counts: the stanza stays a source); disable: the file with the frozen repo taken out of each
# enabled stanza (the stanza disabled when it named nothing else, its other URIs kept when it did)
sources_awk() { # MODE FILE
	awk -v mode="$1" -v new="$URIHOST" -v suite="$suite" '
		function flush(   k, t, ntok, keep, libre, oth, mine, hs, hd) {
			if (n == 0) return
			v = uris; sub(/^[^:]*:/, "", v)
			ntok = split(v, t, /[[:space:]]+/); keep = ""; libre = 0; oth = 0
			for (k = 1; k <= ntok; k++) {
				if (t[k] == "") continue
				if (t[k] ~ /deb\.libre\.computer/) libre = 1
				else { oth = 1; keep = keep " " t[k] }
			}
			mine = libre && !off
			if (mode == "ours" && mine) c++
			if (mode == "other" && (oth || (off && libre))) c++
			hs = 0
			ntok = split(suites, t, /[[:space:]]+/)
			for (k = 1; k <= ntok; k++) if (t[k] == suite) hs = 1
			hd = 0
			ntok = split(types, t, /[[:space:]]+/)
			for (k = 1; k <= ntok; k++) if (t[k] == "deb") hd = 1
			if (mode == "new" && !off && index(v, new) && hs && hd) c++
			if (mode == "disable") {
				for (k = 1; k <= n; k++) {
					if (mine && oth && isuri[k]) continue
					if (mine && !oth && tolower(line[k]) ~ /^enabled:/) continue
					print line[k]
				}
				if (mine && oth) print "URIs:" keep
				if (mine && !oth) print "Enabled: no"
				print ""
			}
			n = 0; uris = ""; suites = ""; types = ""; off = 0; field = ""
			split("", isuri)
		}
		{ sub(/\r$/, "") }
		/^$/ { flush(); next }
		/^#/ { line[++n] = $0; next }
		{
			line[++n] = $0
			l = tolower($0)
			# a continuation line (white space first): part of the field before it
			if (l ~ /^[[:space:]]/) {
				if (field == "uris") { uris = uris " " $0; isuri[n] = 1 }
				if (field == "suites") suites = suites " " $0
				if (field == "types") types = types " " $0
				next
			}
			field = l; sub(/:.*/, "", field)
			if (field == "uris") { uris = $0; isuri[n] = 1 }
			if (field == "suites") { suites = $0; sub(/^[^:]*:/, "", suites) }
			if (field == "types") { types = $0; sub(/^[^:]*:/, "", types) }
			if (l ~ /^enabled:[[:space:]]*(no|false|without|off|disable|0)[[:space:]]*$/) off = 1
		}
		END { flush(); if (mode != "disable") print c + 0 }
	' "$2"
}
count() { # MODE FILE: entries of that kind in one sources file, either format
	case $2 in
		*.sources) sources_awk "$1" "$2" ;;
		*) list_awk "$1" "$2" ;;
	esac
}

# the board's suite on packages.libre.computer, if it has one
. /etc/os-release
case "${ID:-}:${VERSION_CODENAME:-}" in
	debian:bookworm|debian:trixie|ubuntu:noble|ubuntu:resolute) suite=$VERSION_CODENAME ;;
	# Raspbian 12 (armhf) reads Debian 12's suite: every package but the kernel is Architecture: all,
	# and the armhf kernel is ARMv7, which these boards are
	raspbian:bookworm) suite=bookworm ;;
	*) suite="" ;;
esac

# the files with an enabled entry for the frozen repo, and whether the board already reads the new one
old="" has_new=0
for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do
	[ -f "$f" ] || continue
	# only a file apt reads: it skips a name with any character outside letters, digits, _ - . : (so no
	# name with a space reaches the loops below)
	case ${f##*/} in *[!A-Za-z0-9_.:-]*) continue ;; esac
	[ "$(count new "$f")" -eq 0 ] || has_new=1
	[ "$(count ours "$f")" -gt 0 ] || continue
	old="$old $f"
done
# move-pending: a move the timer retries (packages.libre.computer was not usable at the last try)
retry_off() { rm -f "$STATE/move-pending"; }
[ -n "$old" ] || { retry_off; exit 0; }

if [ -z "$suite" ]; then
	say "this release (${ID:-unknown} ${VERSION_CODENAME:-unknown}) is not served by packages.libre.computer; staying on deb.libre.computer"
	retry_off
	exit 0
fi

# a kernel channel packages.libre.computer does not carry keeps the board on the frozen repo
others=$(dpkg-query -W -f '${db:Status-Status} ${Package}\n' 'linux-image-lc-*' 2>/dev/null |
	awk '$1 == "installed" {print $2}' |
	grep -E '^linux-image-lc-.+-(arm64|arm|armhf|amd64)$' |
	grep -vE '^linux-image-lc-lts-(arm64|arm|armhf|amd64)$' || true)
if [ -n "$others" ]; then
	say "this board follows a kernel channel packages.libre.computer does not carry ($(echo $others)); staying on deb.libre.computer"
	retry_off
	exit 0
fi

T=$(mktemp -d)
trap 'rm -rf "$T"' EXIT
chmod 755 "$T"
stanza() { # KEY: the new source's stanza
	printf 'Types: deb\nURIs: %s\nSuites: %s\nComponents: main non-free\nSigned-By: %s\n' "$URI" "$suite" "$1"
}

# packages.libre.computer must be usable from here before anything changes: apt itself updates the new
# source alone into scratch lists (apt's proxy settings apply; it checks the signature, and the Release
# date against the board's clock). A proxy or an egress allowlist can admit only the old host
mkdir -p "$T/parts" "$T/lists/partial" "$T/cache/archives/partial"
! id _apt >/dev/null 2>&1 || chown _apt "$T/lists/partial" "$T/cache/archives/partial"
stanza "$PROBE_KEY" > "$T/parts/probe.sources"
if ! apt-get -q -o Dir::Etc::SourceList=/dev/null -o Dir::Etc::SourceParts="$T/parts" \
	-o Dir::State::Lists="$T/lists" -o Dir::Cache="$T/cache" update >"$T/probe.log" 2>&1 ||
	! ls "$T/lists/" 2>/dev/null | grep -q 'InRelease$'; then
	say "packages.libre.computer ($URI) is not usable from this board; staying on deb.libre.computer for now, and trying again every 6 hours (or run 'dpkg-reconfigure $PKG'). apt said:"
	grep -E '^(E|W|Err):' "$T/probe.log" | sed 's/^/  /' || true
	# a network or clock fault at upgrade time must not leave the board on the frozen repo for good
	mkdir -p "$STATE"
	touch "$STATE/move-pending"
	systemctl enable libre-computer-migrate.timer >/dev/null 2>&1 || true
	[ ! -d /run/systemd/system ] || systemctl start libre-computer-migrate.timer >/dev/null 2>&1 || true
	exit 0
fi

mkdir -p "$STATE/moved-sources"
stamp=$(date +%Y%m%d%H%M%S)
backup() { # FILE: the path its original is kept at
	b=$STATE/moved-sources/$(basename "$1")
	[ ! -e "$b" ] || b=$b.$stamp
	echo "$b"
}

# 1. the new source in place first, so the board never lacks one (a full disk stops here, before anything
# changed). A board that already reads packages.libre.computer keeps its own entry: a second one with a
# different Signed-By would make apt refuse every source. libre-computer.sources holding entries of its
# own keeps them: ours in it are disabled and the new stanza added after them
if [ $has_new = 0 ]; then
	if [ ! -e "$SRC" ] || { [ "$(count other "$SRC")" -eq 0 ] && [ "$(count ours "$SRC")" -gt 0 ]; }; then
		stanza "$KEY" > "$T/src"
	else
		sources_awk disable "$SRC" > "$T/src"
		stanza "$KEY" >> "$T/src"
	fi
	readable_before=0
	apt-get -q indextargets >/dev/null 2>&1 && readable_before=1
	src_backup=""
	if [ -e "$SRC" ]; then
		src_backup=$(backup "$SRC")
		cp -p "$SRC" "$src_backup"
	fi
	cat "$T/src" > "$SRC.new"
	mv "$SRC.new" "$SRC"
	# apt judges the sources as a whole: an entry of the board's own for packages.libre.computer in a shape
	# this script does not recognise (another scheme, deb-src only, another Signed-By) can make apt refuse
	# every source beside the new one. Then nothing has changed yet: the previous file comes back
	if [ $readable_before = 1 ] && ! apt-get -q indextargets >"$T/after.log" 2>&1; then
		if [ -n "$src_backup" ]; then cp -p "$src_backup" "$SRC"; else rm -f "$SRC"; fi
		say "apt cannot read the sources with packages.libre.computer added beside the board's own entry for it; staying on deb.libre.computer. apt said:"
		grep -E '^(E|W):' "$T/after.log" | sed 's/^/  /' || true
		retry_off
		exit 0
	fi
fi

# 2. the migration pending and its timer enabled, before the old entries go: an interruption from here
# leaves both sources (apt reads both) and the migration still runs
touch "$STATE/migrate-pending"
retry_off
systemctl enable libre-computer-migrate.timer >/dev/null 2>&1 || true

# 3. the deb.libre.computer entries out
for f in $old; do
	# libre-computer.sources was rewritten in step 1, unless the board already had the new source
	[ $has_new = 1 ] || [ "$f" != "$SRC" ] || continue
	case $f in
		/etc/apt/sources.list) whole=0 ;;
		*) [ "$(count other "$f")" -eq 0 ] && whole=1 || whole=0 ;;
	esac
	if [ $whole = 1 ]; then
		mv "$f" "$(backup "$f")"
		continue
	fi
	# a file with other entries too: the original kept, ours disabled in place -- in the file itself, or in
	# the file a symlink names (the link stays a link), through a copy renamed over it
	cp -p "$f" "$(backup "$f")"
	real=$(readlink -f "$f")
	case $f in
		*.sources) sources_awk disable "$f" > "$real.lc-new" ;;
		*) list_awk disable "$f" > "$real.lc-new" ;;
	esac
	mv "$real.lc-new" "$real"
done
say "moved to packages.libre.computer ($suite); the old source files are in $STATE/moved-sources"

# 4. the renames need apt, which is busy until this install finishes: the timer retries until they are
# done, and a transient timer starts them 30 s from now
if [ -d /run/systemd/system ]; then
	systemctl start libre-computer-migrate.timer >/dev/null 2>&1 || true
	systemd-run --quiet --no-block --on-active=30 --unit="libre-computer-migrate-now-$stamp" \
		systemctl start --no-block libre-computer-migrate.service >/dev/null 2>&1 ||
		say "the renames run within minutes of the next boot"
else
	say "the renames run within minutes of the next boot"
fi
