[Unit]
Description=Retry the Libre Computer package renames until they are done
# either mark (| makes them alternatives): the renames, or the kernel meta waiting for the owner's upgrade
ConditionPathExists=|/var/lib/libre-computer-archive-keyring/migrate-pending
ConditionPathExists=|/var/lib/libre-computer-archive-keyring/kernel-pending

[Timer]
# a few minutes after boot, when the network is up and the clock (no RTC on most boards) has been set,
# then every 6 hours on a board that stays up
OnBootSec=5min
OnUnitInactiveSec=6h
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
