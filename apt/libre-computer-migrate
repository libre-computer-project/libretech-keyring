#!/bin/sh
# libre-computer-migrate -- the one-shot after libre-computer-move switched a board to
# packages.libre.computer: for each package the board has under an old name, install its new name.
# Each new package Breaks, Replaces and Provides the old one, so apt removes the old in the same step; the
# old names need not be in the repository (package-naming policy rule 6.5). Run by
# libre-computer-migrate.timer until it is done.
#
# It removes nothing but the old names: apt's plan is read before every attempt, and a step that would
# remove any other package is refused (the board keeps its packages; the timer tries again later). It
# installs no Recommends and no kernel: a renamed kernel meta-package (armhf linux-image-lc-lts-arm ->
# -armhf) comes with the owner's own upgrade, through the transitional package; the timer then gives the
# new name the old one's mark and removes the old one (kernel-pending, checked without apt-get update).
# A new name takes its old name's manual/automatic mark, so autoremove never takes it. A move that could not
# reach packages.libre.computer when the keyring was installed (move-pending) is tried again here first.
set -eu
STATE=/var/lib/libre-computer-archive-keyring
failed=0 dpkg_broken=0
say() { echo "libre-computer-migrate: $*"; }
# state_here: the keyring is still on the board before this run writes into its state or dpkg's again: its
# state directory (a purge removes it, in the postrm) and its files (a remove takes them; the guard stands for
# them). The owner removing or purging the keyring while this run waits is theirs: the run stops, leaving no
# directory behind it and changing no mark
state_here() {
	[ -d "$STATE" ] && [ -e "$GUARD" ] && return 0
	say "the keyring was removed meanwhile; stopping"
	exit 0
}
[ -e "$STATE/migrate-pending" ] || [ -e "$STATE/kernel-pending" ] || [ -e "$STATE/move-pending" ] || exit 0

export DEBIAN_FRONTEND=noninteractive
# apt's and dpkg's messages untranslated: is_locked reads them (a service inherits the system locale)
export LC_ALL=C
# no DPkg::Lock::Timeout: wait_lock waits for every lock (apt's own wait covers dpkg's alone, and would add
# its timeout to each of wait_lock's retries)
# no AutomaticRemove: a board that sets it would have every attempt also remove what nothing needs any more,
# which the removal guard refuses, so no rename would ever go in
# and no Suggests (a board may set Install-Suggests): a rename adds nothing the board did not have
GUARD=/usr/lib/libre-computer-archive-keyring/libre-computer-rename-guard
APT="apt-get -q -y -o APT::Get::AutomaticRemove=false -o APT::Install-Suggests=false -o Dpkg::Options::=--force-confold -o Dpkg::Options::=--force-confdef"
W=$(mktemp -d)
# readable by _apt, which apt-get download (keyring_swap) fetches as
chmod 755 "$W"
# the "renaming" mark is held only while an apt run of the renames is under way (safe_apt): the old package's
# postrm then keeps the timer and the state for the rename; any other time, a removal is the owner's
trap 'rm -rf "$W"; rm -f "$STATE/renaming"' EXIT
# a stop (shutdown) while apt or dpkg runs: the shell runs this once that command has finished, so dpkg is
# never left half-done by us (the unit's KillMode=process signals this script alone)
trap 'say "stopping after the step that was running"; exit 1' TERM
# "installed" if any architecture of PACKAGE is installed (dpkg-query prints one line per installed arch). A
# package configured and only awaiting triggers (triggers-awaited, -pending: as apt's closing --configure
# --pending, cut short, leaves them) is installed: dpkg processes its triggers in any configure run
st() { ! dpkg-query -W -f '${db:Status-Status}\n' "$1" 2>/dev/null | grep -qxE 'installed|triggers-awaited|triggers-pending' || echo installed; }
# pr PACKAGE: true if any architecture of it is on the board in any state but removed (installed, or left
# unpacked, half-configured -- as an old keyring deconfigured by keyring_swap is). dpkg-query exits 1 for a
# package it does not know (not present); any other failure (its database unreadable) counts as present, so no
# step takes an old name for gone that it cannot see
pr() {
	ps_=$(dpkg-query -W -f '${db:Status-Status}\n' "$1" 2>/dev/null) || { rc_=$?; [ "$rc_" != 1 ]; return; }
	printf '%s\n' "$ps_" | grep -qvxE 'not-installed|config-files'
}
# never_began OLD NEW: true only if dpkg-query answers for both, OLD whole on the board (an architecture of it
# installed or only awaiting triggers, none part-done; one not on the board, config-files or not-installed, is
# no part of it) and NEW not on the board at all (not installed or config-files only, or unknown) -- a rename
# record (pending-NEW) is dropped on nothing less. A failing query, an old name part-way out (half-configured
# or half-installed in the rename's own removal) or a new name part-way in keeps it: a record is the one trace
# of a rename that took the old name and never brought the new one
never_began() {
	os_=$(dpkg-query -W -f '${db:Status-Status}\n' "$1" 2>/dev/null) || return 1
	printf '%s\n' "$os_" | grep -qxE 'installed|triggers-awaited|triggers-pending' || return 1
	! printf '%s\n' "$os_" | grep -qvxE 'installed|triggers-awaited|triggers-pending|not-installed|config-files' || return 1
	if ns_=$(dpkg-query -W -f '${db:Status-Status}\n' "$2" 2>/dev/null); then
		! printf '%s\n' "$ns_" | grep -qvxE 'not-installed|config-files'
	else
		# 1: dpkg does not know it (not on the board); anything else: no answer
		[ $? = 1 ]
	fi
}
# Part-done dpkg work is never this script's to finish, whoever left it (a power loss or a kill in one of its
# own runs included): proving which part-done package is whose takes a lock dpkg offers no way to hold across a
# check and an action. While dpkg holds a package part-done, or its journal has entries, the renames wait,
# saying why; dpkg's owner finishes it (dpkg --configure -a, apt -f install), as apt itself asks. A rename such
# a stop cut short after apt had taken the old name is resumed once dpkg is whole (pending-NEW).
# except: the part-done package the renames leave on purpose -- libretech-keyring, deconfigured by keyring_swap
# once libre-computer-archive-keyring is in (the renames then remove it). A run may also take out a part-done
# package it removes (whole REMOVED): a removal configures nothing -- an old name a power loss left half-way out
# of the board, which dpkg --configure -a cannot finish and no repository still has to reinstall
# (exactly that one: a libretech-keyring in the range libre-computer-archive-keyring Breaks, which dpkg could
# never configure beside it; the owner's transitional libretech-keyring of the same version is not excepted)
except() {
	[ "$(st libre-computer-archive-keyring)" = installed ] || return 0
	ov=$(dpkg-query -W -f '${Version}' libretech-keyring 2>/dev/null) || return 0
	nv=$(dpkg-query -W -f '${Version}' libre-computer-archive-keyring 2>/dev/null) || return 0
	[ -z "$ov" ] || ! dpkg --compare-versions "$ov" lt "$nv" || echo libretech-keyring
}
# partdone [EXTRA...]: " NAME..." of the packages dpkg holds part-done (unpacked, half-installed,
# half-configured), less the exception and EXTRA. A package only awaiting triggers (triggers-pending, -awaited) is
# not part-done: dpkg processes its triggers in any configure run, as apt's closing one, and nothing is decided.
# dpkg's database unreadable: " (dpkg-query failed)", so the check fails closed
partdone() {
	if ! dq=$(dpkg-query -W -f '${db:Status-Status} ${binary:Package}\n' 2>/dev/null); then
		echo " (dpkg-query failed)"
		return 0
	fi
	printf '%s\n' "$dq" | awk -v ex=" $(except) $* " '
		$1 != "unpacked" && $1 != "half-installed" && $1 != "half-configured" { next }
		{ n = $2; sub(/:.*/, "", n); if (index(ex, " " n " ") == 0) printf " %s", $2 }'
}
# dirty: dpkg's journal holds entries (a dpkg run was cut short; apt refuses to run until dpkg --configure -a).
# Its entries are the all-digit files in updates/, as apt and dpkg read them (a stray tmp.i is not one)
dirty() { ls /var/lib/dpkg/updates 2>/dev/null | grep -qxE '[0-9]+'; }
# whole [REMOVED...]: say what holds the renames back, if anything (then false)
whole() {
	if dirty; then
		say "a dpkg run was cut short (its journal has entries); the renames wait until it is finished: run 'dpkg --configure -a' (will retry)"
		return 1
	fi
	pd=$(partdone "$@")
	if [ -n "$pd" ]; then
		say "dpkg holds packages part-done:$pd; the renames wait until they are finished: run 'dpkg --configure -a', or 'apt-get -f install' (will retry)"
		return 1
	fi
}

# old name -> new name (the package-naming policy's table). kpairs: kernel meta-packages, never installed
# here
pairs="libretech-gpio:libre-computer-gpio
libretech-dtoverlay:libre-computer-dtoverlay
libretech-alsa-ucm-conf:alsa-ucm-conf-libre-computer
xserver-xorg-video-libretech:xserver-xorg-core-libre-computer
libretech-keyring:libre-computer-archive-keyring"
kpairs="linux-image-lc-lts-arm:linux-image-lc-lts-armhf
linux-headers-lc-lts-arm:linux-headers-lc-lts-armhf"
# what an attempt may remove ($allow) is set per attempt (install_new, remove_old)
allow=" "

# is_locked: the output in $W/out says another apt or dpkg holds a lock. apt: "Could not get lock ...";
# dpkg: "dpkg frontend lock was locked by <program> process with pid N" (older: "by another process"),
# "dpkg status database is locked by another process"
is_locked() { grep -qiE 'could not get lock|lock (was|is) locked by|database is locked' "$W/out"; }
# run CMD..., output in $W/out, retrying every 30 s for up to 2 h while a lock is held (the apt run that
# installed this package may still be going, with a kernel and its initramfs)
wait_lock() {
	wi=0
	while :; do
		if "$@" >"$W/out" 2>&1; then return 0; fi
		is_locked && [ $wi -lt 240 ] || return 1
		wi=$((wi + 1))
		sleep 30
	done
}
# idle: wait (as wait_lock does) until no other apt or dpkg runs. apt-get check opens the cache as an install
# would, taking apt's and dpkg's locks, and changes nothing (a simulation, -s, takes no lock at all). dpkg left
# half-done by someone else makes it fail at once: then there is nothing to wait for
idle() { wait_lock apt-get -q check || true; }
# idle_free: idle, and true only if no other apt or dpkg held a lock at its end (wait_lock gives up after 2 h:
# an apt a killed run of this script's left running can outlast that)
idle_free() { wait_lock apt-get -q check && return 0; ! is_locked; }

# safe_apt ARGS: apt-get ARGS, only if its plan removes nothing but the names in $allow (set by the caller). The plan is read
# again before every attempt: while a lock is held, another apt may change what this one would do
# run_begin / run_end: around each run of this script's that changes dpkg's state (apt's, or keyring_swap's
# dpkg): the "renaming" mark -- this boot, this script's pid and its start time (a pid can be reused in the same
# boot), so a mark a power loss or a kill left is not a rename under way; "-" for a value it cannot read, as the
# postrm reads them (the start time: the 20th field after the ") " that ends the command name in stat)
run_begin() {
	state_here
	bid=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)
	bst=$(sed 's/.*) //' "/proc/$$/stat" 2>/dev/null | cut -d' ' -f20 || true)
	echo "${bid:--} $$ ${bst:--}" > "$STATE/renaming"
}
run_end() { rm -f "$STATE/renaming"; }
# pending-NEW: a rename begun -- NEW's mark-to-be (its old name's). keep_mark sets the mark, or the next run does
# if this one stops in between; the next run also installs a new name whose rename a stop cut short after the old
# name had gone (a record whose old name is gone is left as it is). It is written at the last moment before the
# old name can go, and synced (dpkg makes what it does durable at once): in an apt run by the guard, after the
# downloads, for the renames whose old name that run removes (pending_spec gives it the marks); before
# keyring_swap's dpkg run by record_pending. Their own names (qp/qo/qn): sh has no local variables
pend=""
# pending_spec NEW...: "OLD NEW MARK" lines for the guard (LC_RENAME_PENDING)
pending_spec() {
	for qp in $pairs; do
		qo=${qp%%:*} qn=${qp#*:}
		case " $* " in *" $qn "*) ;; *) continue ;; esac
		pr "$qo" || continue
		case $autos in *" $qo "*) echo "$qo $qn auto" ;; *) echo "$qo $qn manual" ;; esac
	done
}
record_pending() {
	state_here
	pending_spec "$@" | while read -r qo qn qm; do
		echo "$qm" > "$STATE/pending-$qn"
		sync "$STATE/pending-$qn" "$STATE" 2>/dev/null || sync
	done
}
safe_apt() {
	si=0 replanned=0
	while :; do
		if ! $APT -s "$@" >"$W/plan" 2>&1; then
			# another apt may be part-way through (a simulation takes no lock and reads what that one is
			# writing): wait for it, then plan once more
			if [ $replanned = 0 ]; then
				replanned=1
				idle
				continue
			fi
			say "apt cannot plan 'apt-get $*'; will retry:"
			sed 's/^/  /' "$W/plan" | tail -n 15
			return 1
		fi
		bad=""
		# apt plans a removal as Remv, or as Purg where APT::Get::Purge is set
		# (a foreign architecture's as pkg:arch: compared by name, as $allow holds names)
		for r in $(awk '$1 == "Remv" || $1 == "Purg" {n = $2; sub(/:.*/, "", n); print n}' "$W/plan"); do
			case $allow in *" $r "*) ;; *) bad="$bad $r" ;; esac
		done
		if [ -n "$bad" ]; then
			say "'apt-get $*' would also remove$bad; not done, nothing changed (will retry)"
			return 1
		fi
		# apt configures what it unpacks with a closing dpkg --configure --pending, which would also configure
		# whatever else dpkg holds part-done: the run happens only while dpkg is whole but for what it removes
		# (the guard checks this again inside apt's run, its locks held)
		# shellcheck disable=SC2046
		whole $(awk '$1 == "Remv" || $1 == "Purg" {n = $2; sub(/:.*/, "", n); print n}' "$W/plan") || return 1
		# shellcheck disable=SC2086
		spec=$([ -z "$pend" ] || pending_spec $pend)
		run_begin
		# shellcheck disable=SC2086
		# the same guards inside apt's run (its plan then final, its locks held): another apt may have changed
		# the board since the plan above; and the guard records the renames the run begins (pending-NEW)
		if LC_RENAME_ALLOW="$allow" LC_RENAME_EXCEPT="$(except)" LC_RENAME_PENDING="$spec" LC_RENAME_STATE="$STATE" \
			$APT -o "DPkg::Pre-Install-Pkgs::=$GUARD" \
			-o "DPkg::Tools::Options::$GUARD::Version=2" "$@" >"$W/out" 2>&1; then
			run_end
			cat "$W/out"
			return 0
		fi
		run_end
		if is_locked && [ $si -lt 240 ]; then
			si=$((si + 1))
			sleep 30
			continue
		fi
		cat "$W/out"
		return 1
	done
}

# each installed new name of PAIRS gets its old name's mark, read once dpkg is free (snapshot(), below). A new
# name pulled in as a dependency of its old (transitional) one is marked automatic; once the old one is removed,
# autoremove would take it -- the kernel meta-package, or the keyring whose key every Libre Computer source line
# names. A new name the owner already had as manual stays manual: only manual is ever copied onto it
snapshot() {
	# (an old name in any state but removed: one left unpacked still has the mark its new name is to take)
	had=" $(for p in $pairs $kpairs; do o=${p%%:*}; ! pr "$o" || printf '%s ' "$o"; done)"
	newmanual=" $(for p in $pairs $kpairs; do n=${p#*:}; [ "$(st "$n")" != installed ] || printf '%s ' "$n"; done)"
	autos=" $(apt-mark showauto 2>/dev/null | tr '\n' ' ') "
	for n in $newmanual; do case $autos in *" $n "*) newmanual=$(echo "$newmanual" | sed "s/ $n / /") ;; esac; done
	newmanual=" $newmanual "
}
# unmarked: the old names whose new name's mark could not be set; they are kept (and retried), so autoremove
# can never take a new name that was left automatic
unmarked=" "
keep_mark() {
	# apt-mark takes no lock: wait until no other apt or dpkg runs, so the copy is not written over by an apt
	# that ends after it
	idle
	state_here
	for p in "$@"; do
		o=${p%%:*} n=${p#*:}
		# the old name's mark, from this run's snapshot; or, its old name gone before this run (an earlier run
		# stopped between the install and here), the one that run recorded before the install (pending-NEW)
		# (a record whose new name is not in yet stays: the rename it records goes on)
		[ "$(st "$n")" = installed ] || continue
		case $had in
			*" $o "*)
				case $autos in *" $o "*) m=auto ;; *) m=manual ;; esac
				# a new name the owner had installed already stays manual
				case $newmanual in *" $n "*) m=manual ;; esac ;;
			*)
				# (the new name, installed by that run, is manual in this run's snapshot: the record decides)
				[ -s "$STATE/pending-$n" ] || continue
				m=$(cat "$STATE/pending-$n") ;;
		esac
		# manual an earlier run could not set (only manual is remembered: an automatic one could undo a manual
		# mark the owner set since, and a new name left manual is never taken by autoremove)
		[ ! -s "$STATE/mark-$n" ] || m=manual
		if wait_lock apt-mark "$m" "$n"; then
			rm -f "$STATE/mark-$n" "$STATE/pending-$n"
		else
			say "could not mark $n $m; keeping $o for now"
			unmarked="$unmarked$o "
			[ "$m" != manual ] || echo manual > "$STATE/mark-$n"
		fi
	done
}
# OLD... less the unmarked ones
marked() { for o in "$@"; do case $unmarked in *" $o "*) ;; *) printf ' %s' "$o" ;; esac; done; }

# install_new NEW...: each attempt may remove only the old names of what it renames (an old name whose new
# name is in this attempt or already installed), so a fallback install of one name cannot take another
# pair's old name whose new name never went in
# (its own names ip/io/in_: sh has no local variables, and the per-name passes call it inside their loop over n)
install_new() {
	allow=" "
	for ip in $pairs; do
		io=${ip%%:*} in_=${ip#*:}
		case " $* " in *" $in_ "*) allow="$allow$io " ; continue ;; esac
		[ "$(st "$in_")" != installed ] || allow="$allow$io "
	done
	pend="$*"
	safe_apt install --no-install-recommends "$@" && pend="" && return 0
	pend=""
	return 1
}
# keyring_swap: libretech-keyring -> libre-computer-archive-keyring, by dpkg itself. apt would remove
# libretech-keyring (its key, this script, the guard, the timer) before unpacking its replacement, and a stop in
# between would leave the board with neither and nothing to try again. dpkg unpacking the new package over the
# old (Replaces) takes each file over in place. The deb.libre.computer libretech-keyring ships no file the new
# one does not, so dpkg drops it as replaced completely (its postrm called with "disappear"); one that kept a
# file of its own would stay deconfigured (its Breaks) and go with the removals below. The package is fetched
# by apt (checked against the signed index) and has no dependencies; nothing else can go: dpkg removes only a
# package whose every file is taken
keyring_swap() {
	rm -rf "$W/dl"
	mkdir "$W/dl"
	! id _apt >/dev/null 2>&1 || chown _apt "$W/dl"
	if ! (cd "$W/dl" && wait_lock apt-get -q download libre-computer-archive-keyring); then
		say "could not fetch libre-computer-archive-keyring; will retry:"
		tail -n 5 "$W/out" | sed 's/^/  /'
		return 1
	fi
	set -- "$W/dl"/libre-computer-archive-keyring_*.deb
	[ -f "$1" ] || { say "apt fetched no libre-computer-archive-keyring; will retry"; return 1; }
	# no other apt or dpkg running, and dpkg whole (dpkg -i would also fold a journal someone else's cut-short
	# run left). dpkg runs once: a lock taken in between fails it at once, and the next run tries again, so the
	# renaming mark is never held across a wait (an owner's removal of the keyring meanwhile stays theirs)
	idle
	whole || return 1
	# (the old keyring still here: the owner may have removed it while this run waited, and that removal is theirs)
	if ! pr libretech-keyring; then
		say "libretech-keyring was removed meanwhile; not installing libre-computer-archive-keyring in its place"
		return 1
	fi
	# nor held: apt refuses to remove a held package, but dpkg -i drops or deconfigures one another package's
	# Replaces and Breaks name without asking. The owner's hold keeps the old keyring (a query that fails
	# counts as a hold)
	kw=$(dpkg-query -W -f '${db:Status-Want}\n' libretech-keyring 2>/dev/null) || kw=hold
	if printf '%s\n' "$kw" | grep -qx hold; then
		say "libretech-keyring is held (apt-mark hold); it stays, and so does its name, until the hold is lifted"
		return 1
	fi
	record_pending libre-computer-archive-keyring
	run_begin
	if dpkg --auto-deconfigure --force-confold --force-confdef -i "$1" >"$W/out" 2>&1; then
		run_end
		return 0
	fi
	run_end
	say "dpkg could not install libre-computer-archive-keyring; will retry:"
	tail -n 15 "$W/out" | sed 's/^/  /'
	return 1
}

# remove OLD...: together, or each on its own when apt refuses that (one held or refused name keeps only
# itself), in passes while a pass takes one out (a name may go only after another that depends on it); each
# attempt may remove only the names it was given. (Its own names ro/rprog, as install_new's)
remove_old() {
	allow=" $* "
	# shellcheck disable=SC2046
	safe_apt remove $(archs "$@") && return 0
	rprog=1
	while [ $rprog = 1 ]; do
		rprog=0
		for ro in "$@"; do
			pr "$ro" || continue
			allow=" $ro "
			# shellcheck disable=SC2046
			safe_apt remove $(archs "$ro") || true
			pr "$ro" || rprog=1
		done
	done
}
# archs NAME...: each name as dpkg holds it on the board, every architecture's (pkg for the native one,
# pkg:arch for another, as apt-get remove needs it); a name dpkg does not answer for, as it is
archs() {
	for an in "$@"; do
		al=$(dpkg-query -W -f '${db:Status-Status} ${binary:Package}\n' "$an" 2>/dev/null |
			awk '$1 != "not-installed" && $1 != "config-files" {print $2}') || al=""
		[ -n "$al" ] && printf '%s\n' "$al" || echo "$an"
	done
}

# the move again, if packages.libre.computer was not usable at the last try (it clears the mark when it moves the
# board, or when there is nothing to move)
if [ -e "$STATE/move-pending" ]; then
	LC_MOVE_FROM_MIGRATE=1 /usr/lib/libre-computer-archive-keyring/libre-computer-move || true
	# (the keyring removed during the move's probe: the move stopped, and so does this run)
	state_here
	if [ -e "$STATE/move-pending" ]; then
		say "packages.libre.computer is still not usable from this board; will retry"
		failed=1
	fi
	[ -e "$STATE/move-pending" ] || [ -e "$STATE/migrate-pending" ] || [ -e "$STATE/kernel-pending" ] || exit 0
fi

# dpkg whole first (no other apt or dpkg running, no journal, nothing part-done but the exception): part-done
# work is dpkg's owner's to finish, never this script's (see partdone); until it is, the renames wait
free=0
! idle_free || free=1
# a rename record whose old name is still here and new one not in is one a stop cut short before that rename's
# removal (a run renaming several, cut short after some): it began nothing, and goes now, before the owner's
# own apt runs can make its old name look taken by the rename (the window left is the time from boot to this
# run). Only on dpkg's clear answer (never_began), with no other apt or dpkg running (free: a lock still held
# could be an apt about to take that old name)
for p in $pairs; do
	o=${p%%:*} n=${p#*:}
	[ $free = 1 ] && [ -e "$STATE/pending-$n" ] && never_began "$o" "$n" && rm -f "$STATE/pending-$n" || true
done
# (an old name part-done is let through here: a rename's run may remove it, and each run checks for itself)
# shellcheck disable=SC2046
if ! whole $(for p in $pairs $kpairs; do printf '%s ' "${p%%:*}"; done); then
	failed=1 dpkg_broken=1
fi
# the marks as they are now that dpkg is free (an apt run that installed the keyring may have just ended)
snapshot

# the renames, once the board reads packages.libre.computer and dpkg is sound; the kernel step below runs either way
if [ -e "$STATE/migrate-pending" ] && [ ! -e "$STATE/move-pending" ] && [ $dpkg_broken = 0 ]; then
	# apt-get update. One failing source of the board's does not stop the migration; packages.libre.computer's
	# lists must be in
	# shellcheck disable=SC2086
	if ! wait_lock $APT update; then
		say "apt-get update reported errors; going on:"
		grep -E '^(E|W):' "$W/out" | sed 's/^/  /' || true
	fi
	# a repository's index lists it (an installed copy alone shows only /var/lib/dpkg/status). Without the
	# lists the renames wait for the next run; the kernel step below runs either way
	if ! apt-cache policy libre-computer-archive-keyring 2>/dev/null | grep -q ' Packages$'; then
		say "packages.libre.computer's package lists are not here (no network, or a clock behind the repository's date); will retry"
	else

		# the new names to install: an old name's on the board, or one whose rename an earlier run began
		# (pending-NEW) and a stop cut short after apt had taken the old name and before the new one was in
		new=""
		for p in $pairs; do
			o=${p%%:*} n=${p#*:}
			[ "$(st "$n")" != installed ] || continue
			pr "$o" || [ -s "$STATE/pending-$n" ] || continue
			new="$new $n"
		done
		if [ -n "$new" ]; then
			say "installing$new (in place of their old names)"
			# (each new name's mark-to-be is recorded just before the run that installs it: record_pending)
			# the keyring by dpkg itself (keyring_swap), never by apt
			case "$new " in
				*" libre-computer-archive-keyring "*)
					keyring_swap || true
					new=$(echo " $new " | sed 's/ libre-computer-archive-keyring / /; s/^ *//; s/ *$//') ;;
			esac
		fi
		if [ -n "$new" ]; then
			# a rename adds nothing the board did not have: not the new packages' Recommends (dtoverlay's i2c-tools,
			# spi-tools; xorg's xserver-xorg), which an owner may have left out on purpose. All in one step (their
			# dependencies on one another resolve together); if apt refuses that, each on its own, so one name
			# that cannot go in (held, missing, or removing something else) does not hold back the others
			# shellcheck disable=SC2086
			if ! install_new $new; then
				# one by one, in passes while a pass gets one in: one name may go in only after another (its
				# old name depends on the other's old name, which it may remove only once that one's new name is in)
				progress=1
				while [ $progress = 1 ]; do
					progress=0
					for n in $new; do
						[ "$(st "$n")" != installed ] || continue
						install_new "$n" || true
						[ "$(st "$n")" != installed ] || progress=1
					done
				done
			fi
		fi
		# a rename that never began (its new name not in, its old one still here: refused, held, missing) has
		# no record left to it: one the next run finds is a rename a stop cut short (with no other apt or dpkg
		# holding a lock, as at the start)
		free=0
		! idle_free || free=1
		for p in $pairs; do
			o=${p%%:*} n=${p#*:}
			[ $free = 0 ] || [ ! -e "$STATE/pending-$n" ] || ! never_began "$o" "$n" || rm -f "$STATE/pending-$n"
		done
		# an old name its new one did not displace (a transitional package, which only Depends on the new name;
		# the keyring keyring_swap deconfigured) goes once the new name is in, the new name keeping the old mark
		gone=""
		for p in $pairs; do
			o=${p%%:*} n=${p#*:}
			pr "$o" && [ "$(st "$n")" = installed ] && gone="$gone $o" || true
		done
		# shellcheck disable=SC2086
		keep_mark $pairs
		# shellcheck disable=SC2086
		gone=$(marked $gone)
		if [ -n "$gone" ]; then
			say "removing$gone (their libre-computer names are installed)"
			# shellcheck disable=SC2086
			remove_old $gone
			# again, now that the removal has had dpkg's lock: an apt that ran alongside is done
			# shellcheck disable=SC2086
			keep_mark $pairs
		fi
		# left: an old name still here, or a rename begun and not finished -- its record still there (its new name
		# not in, or in without the old name's mark yet: keep_mark removes the record once the mark is set)
		left=""
		for p in $pairs; do
			o=${p%%:*} n=${p#*:}
			if pr "$o" || [ -s "$STATE/pending-$n" ]; then
				left="$left $o"
			fi
		done
		# a name still under its old one is retried; the kernel step below runs either way
		if [ -n "$left" ]; then
			say "still installed under an old name:$left; will retry"
		else
			# (migrate-pending goes after the kernel step's own mark is on disk, below: a power loss between the
			# two must not leave neither)
			renames_done=1
			say "done: the board reads packages.libre.computer under the libre-computer names"
		fi
	fi
fi

# the kernel meta-packages: once the owner's upgrade has put a new name in, it takes the old name's mark and
# the old (transitional) one goes; until then the timer checks again, with no apt-get update. Its removal is
# optional: a refusal keeps the transitional package, which only Depends on the new name
waiting="" kgone=""
# only on a board that moved: on the frozen repo the new kernel names never come, and waiting for them would
# keep the timer running for good
[ -e "$STATE/moved" ] || kpairs=""
# (an old name in any state but removed: one the owner's upgrade left unpacked, a failing kernel postinst, still
# waits for its removal; the removal configures nothing)
for p in $kpairs; do
	o=${p%%:*} n=${p#*:}
	pr "$o" || continue
	if [ "$(st "$n")" = installed ]; then kgone="$kgone $o"; else waiting="$waiting $o"; fi
done
if [ -n "$kgone" ]; then
	say "removing$kgone (their new names are installed)"
	# shellcheck disable=SC2086
	keep_mark $kpairs
	# shellcheck disable=SC2086
	kgone=$(marked $kgone)
	# shellcheck disable=SC2086
	[ -z "$kgone" ] || remove_old $kgone
	# again, now that the removal has had dpkg's lock: an apt that ran alongside is done
	# shellcheck disable=SC2086
	keep_mark $kpairs
	# one still here (its new name's mark could not be set, or its removal failed: a lock held past 2 h, a dpkg
	# error) is tried again
	for p in $kpairs; do
		o=${p%%:*} n=${p#*:}
		! pr "$o" || [ "$(st "$n")" != installed ] || waiting="$waiting $o"
	done
fi
if [ -n "$waiting" ]; then
	state_here
	touch "$STATE/kernel-pending"
	sync "$STATE/kernel-pending" "$STATE" 2>/dev/null || sync
	say "the kernel's new names come with your next 'apt upgrade';$waiting stay until then"
else
	rm -f "$STATE/kernel-pending"
fi
[ "${renames_done:-0}" = 0 ] || rm -f "$STATE/migrate-pending"
[ ! -e "$STATE/migrate-pending" ] && [ ! -e "$STATE/move-pending" ] && [ $failed = 0 ] || exit 1
[ -e "$STATE/kernel-pending" ] || systemctl disable libre-computer-migrate.timer >/dev/null 2>&1 || true
