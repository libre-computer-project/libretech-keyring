[Unit]
Description=Move the Libre Computer packages to their libre-computer names (once, after the move to packages.libre.computer)
ConditionPathExists=/var/lib/libre-computer-archive-keyring/migrate-pending
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
Type=oneshot
ExecStart=/usr/lib/libre-computer-archive-keyring/libre-computer-migrate
# waits up to 30 min for each apt or dpkg lock; a failure leaves the pending mark and the timer retries
TimeoutStartSec=2h
Nice=10
# no [Install]: libre-computer-migrate.timer starts it, so no boot target waits on apt
